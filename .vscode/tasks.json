{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CEVphantan Prepare Dev Stack",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\dev-start.ps1",
        "-PrepareOnly"
      ],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "CEVphantandev",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CEVphantan Edge Functions",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\dev-edge-functions.ps1"
      ],
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "CEVphantanedge",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "CEVphantanedge",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[CEVphantan\] Edge Functions serve starting",
          "endsPattern": "\\[CEVphantan\] Edge Functions ready"
        }
      }
    },
    {
      "label": "CEVphantan Docs",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\dev-docs.ps1"
      ],
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "CEVphantandocs",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "CEVphantandocs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[CEVphantan\] Docs dev server starting",
          "endsPattern": "\\[CEVphantan\] Docs ready"
        }
      }
    },
    {
      "label": "CEVphantan Vite",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\dev-vite.ps1"
      ],
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "CEVphantanvite",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "CEVphantanvite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[CEVphantan\] Vite dev server starting",
          "endsPattern": "\\[CEVphantan\] Vite ready"
        }
      }
    },
    {
      "label": "CEVphantan Start Full Dev Stack",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CEVphantan Prepare Dev Stack",
        "CEVphantan Edge Functions",
        "CEVphantan Docs",
        "CEVphantan Vite"
      ],
      "problemMatcher": []
    },
    {
      "label": "CEVphantan Start Full Dev Stack (Reset DB)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\dev\\dev-start.ps1",
        "-Force"
      ],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "group": "CEVphantandev",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CEVphantan Stop Dev Stack",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
